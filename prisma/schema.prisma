  poin            Int
  tipe_transaksi  tipe_poin_enum
  id_referensi    BigInt?
  tabel_referensi String?        @db.VarChar(50)
  saldo_sebelum   Int
  saldo_sesudah   Int
  tanggal_dibuat  DateTime       @default(now()) @db.Timestamptz(6)
  agent           Agent          @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade)

  @@index([id_agent], map: "idx_riwayat_agent")
  @@index([tipe_transaksi], map: "idx_riwayat_tipe")
  @@index([tanggal_dibuat], map: "idx_riwayat_tanggal")
  @@map("riwayat_poin")
}

model Acara {
  id_acara         BigInt            @id @default(autoincrement())
  id_agent         String?           @db.VarChar(20)
  id_property      BigInt?
  judul_acara      String            @db.VarChar(255)
  deskripsi        String?
  tipe_acara       tipe_acara_enum
  tanggal_mulai    DateTime          @db.Timestamptz(6)
  tanggal_selesai  DateTime          @db.Timestamptz(6)
  lokasi           String?           @db.VarChar(255)
  durasi_pilih     Int?
  status_acara     status_acara_enum @default(DRAFT)
  reminder_sent    Boolean           @default(false)
  tanggal_dibuat   DateTime          @default(now()) @db.Timestamptz(6)
  tanggal_diupdate DateTime          @default(now()) @db.Timestamptz(6)
  sudah_dimulai    Boolean           @default(false)
  id_klien_ref     String?           @db.VarChar(20)
  agent            Agent?            @relation(fields: [id_agent], references: [id_agent])
  listing          Listing?          @relation(fields: [id_property], references: [id_property])
  klienRef         Klien?            @relation("KlienFollowUpAcara", fields: [id_klien_ref], references: [id_klien], onDelete: SetNull, map: "acara_klien_ref_fk")
