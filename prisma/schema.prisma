model PreferensiKlien {
  id_preferensi BigInt @id @default(autoincrement())
  id_klien      String @db.VarChar(20)

  /// NULL = SEMUA tipe. Bawaan yang paling sering benar: klien menyebut
  /// daerah & anggaran lebih dulu daripada menyebut rumah atau ruko. Yang
  /// WAJIB adalah lokasi — ditegakkan formulir & API, bukan NOT NULL, karena
  /// lokasinya tersebar di empat kolom yang mana pun boleh terisi.
  tipe_properti     kategori_properti_enum?
  /// BELI atau SEWA. Ada karena `jenis_transaksi` boleh kosong ("rumah di
  /// Gresik maks 500 jt") sementara mesin pencocokan tetap wajib tahu ini
  /// orang mau beli atau menyewa — rumah yang sama bisa terdaftar sebagai dua
  /// listing berbeda. BELI membuka PRIMARY/SECONDARY/LELANG/CESSIE; SEWA
  /// hanya membuka SEWA. Keselarasannya dengan jenis_transaksi ditegakkan
  /// CHECK `preferensi_maksud_selaras` di database, bukan cuma di aplikasi.
  /// Butuh migrasi manual — prisma/migration_rekomendasi_klien.sql.
  maksud            maksud_preferensi_enum  @default(BELI)
  jenis_transaksi   jenis_transaksi_enum?
  lokasi_dicari     String?                 @db.VarChar(255)
  loc_provinsi      String?                 @db.VarChar(150)
  loc_kota          String?                 @db.VarChar(150)
  loc_kecamatan     String?                 @db.VarChar(150)
  loc_kelurahan     String?                 @db.VarChar(150)
  budget_min        Decimal?                @db.Decimal(20, 2)
  budget_max        Decimal?                @db.Decimal(20, 2)
  luas_min          Decimal?                @db.Decimal(12, 2)
  luas_max          Decimal?                @db.Decimal(12, 2)
  tujuan_beli       tujuan_beli_enum?
  /// Sertifikat yang diminta klien. NULL = tidak mempermasalahkan — keadaan
  /// bawaan dan yang paling sering benar. Satu-satunya kriteria tambahan yang
  /// bisa dijawab data listing (99,9% terisi); kamar tidur & luas bangunan
  /// hanya terisi 4–5 baris dari 120 ribu, jadi sengaja TIDAK jadi kriteria.
  /// Butuh migrasi manual — prisma/migration_preferensi_legalitas.sql.
  legalitas         sertifikat_enum?
  /// Token tempat, SAMA PERSIS dengan param `?dekat=` di searchbar (slug,
  /// "brand:x", "cocok:x", atau "kelas:X"). Disimpan sebagai token, bukan
  /// id_tempat: satu pilihan bisa mewakili banyak baris kamus, pilihan "jenis
  /// tempat" sama sekali bukan id, dan id bisa berubah saat kamus disegarkan.
  /// Diterjemahkan `bacaTempatTerpilih()` saat pencocokan.
  /// Butuh migrasi manual — prisma/migration_preferensi_dekat.sql.
  dekat_nilai       String?                 @db.VarChar(220)
  /// Radius meter. NULL = pakai bawaan kelas tempatnya.
  dekat_radius      Int?
  /// Patokan berupa teks alamat — nama jalan / perumahan yang tidak ada di
  /// kamus tempat. Dicocokkan ke listing.alamat_lengkap.
  alamat_teks       String?                 @db.VarChar(160)
  catatan           String?
  /// NULL = kriteria ini belum pernah diadu dengan persediaan yang SUDAH ADA.
  /// Tanpa kolom ini, klien yang preferensinya baru dibuat tidak pernah
  /// dikabari soal aset lama yang cocok — pemindai hanya melihat listing baru,
  /// dan aset yang sudah lama ada di database tidak pernah jadi "baru" lagi.
  /// Diisi sekali oleh cron sesudah pencocokan penuh + email pertama.
  /// Butuh migrasi manual — prisma/migration_asisten_pemindaian.sql.
  terakhir_dipindai DateTime?               @db.Timestamptz(6)

  dibuat_pada     DateTime @default(now()) @db.Timestamptz(6)
  diperbarui_pada DateTime @default(now()) @db.Timestamptz(6)

  klien   Klien                @relation(fields: [id_klien], references: [id_klien], onDelete: Cascade, map: "preferensi_klien_fk")
  kiriman KirimanRekomendasi[]

  @@index([id_klien], map: "idx_preferensi_klien")
  @@map("preferensi_klien")
}

/// Nisan prospek: penanda bahwa agent SENGAJA membuang seorang calon klien,
/// supaya sinkron prospek tidak menghidupkannya kembali beberapa detik
/// kemudian. Menyimpan waktu, bukan sekadar daftar hitam — aktivitas sumber
/// yang LEBIH BARU dari nisannya tetap masuk, karena calon pembeli yang
/// menghubungi lagi bukan sampah lama.
/// Butuh migrasi manual — prisma/migration_prospek_diabaikan.sql.
model ProspekDiabaikan {
  id             BigInt   @id @default(autoincrement())
  id_agent       String   @db.VarChar(20)
  /// Nomor ternormalisasi (62xxx) atau "lead:<id>". Bentuknya ditentukan
  /// src/lib/prospek.ts dan HARUS sama dengan yang dipakai sinkron.
  kunci          String   @db.VarChar(64)
  diabaikan_pada DateTime @default(now()) @db.Timestamptz(6)
  nama_terakhir  String?  @db.VarChar(150)

  agent Agent @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade, map: "prospek_diabaikan_agent_fk")

  @@unique([id_agent, kunci], map: "prospek_diabaikan_unik")
  @@index([id_agent], map: "idx_prospek_diabaikan_agent")
  @@map("prospek_diabaikan")
}

/// Sampai mana tiap pemindai latar sudah benar-benar memproses.
///
/// Ada karena jendela geser ("listing 26 jam terakhir") KEHILANGAN kejadian
/// secara diam-diam: proses yang mati tiga jam membuat listing di jam-jam itu
/// berada di luar jendela pada putaran berikutnya, dan tidak akan pernah masuk
/// jendela mana pun lagi. Tanda air maju HANYA setelah putaran berhasil, jadi
/// proses yang sempat mati mengejar ketinggalannya sendiri.
/// Butuh migrasi manual — prisma/migration_asisten_pemindaian.sql.
model CronWatermark {
  kunci           String   @id @db.VarChar(64)
  waktu           DateTime @db.Timestamptz(6)
  /// Pemecah seri: impor borongan menulis ratusan baris dengan cap waktu yang
  /// sama persis, dan batas "> waktu" saja akan melewatkan sebagian di
  /// antaranya atau memprosesnya dua kali.
  id_terakhir     BigInt?
  diperbarui_pada DateTime @default(now()) @db.Timestamptz(6)
  catatan         String?

  @@map("cron_watermark")
}

/// ── REM EMAIL ASISTEN ─────────────────────────────────────────────────────
/// Satu baris = satu email asisten yang sudah dikirim ke seorang agent untuk
/// satu slot waktu. Yang menegakkan "paling banyak sekian email per hari"
/// adalah unik (id_agent, kunci) di database, BUKAN pemeriksaan di kode:
/// pemindaian bisa berjalan dua kali bersamaan, dan rem berupa baca-lalu-tulis
/// bocor persis di celah itu. INSERT yang berhasil = izin mengirim.
/// Butuh migrasi manual — prisma/migration_email_asisten.sql.
model EmailAsisten {
  id           BigInt   @id @default(autoincrement())
  id_agent     String   @db.VarChar(20)
  /// 'ASETBARU:<YYYY-MM-DD>:<slot>' — lihat KUNCI_SLOT di cron rekomendasi.
  kunci        String   @db.VarChar(80)
  dikirim_pada DateTime @default(now()) @db.Timestamptz(6)
  jumlah_klien Int      @default(0)
  jumlah_aset  Int      @default(0)
  /// Baris ditulis SEBELUM SMTP dicoba (itulah yang membuatnya jadi rem), jadi
  /// kolom ini yang membedakan "sudah benar-benar sampai" dari "slot sudah
  /// diambil tapi pengirimannya gagal".
  terkirim     Boolean  @default(false)

  agent Agent @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade, map: "email_asisten_agent_fk")

  @@unique([id_agent, kunci], map: "email_asisten_unik")
  @@index([dikirim_pada(sort: Desc)], map: "idx_email_asisten_waktu")
  @@map("email_asisten")
}

/// ── BUKU KIRIMAN ──────────────────────────────────────────────────────────
/// Satu baris per (klien × aset) yang PERNAH dikirim, seumur hidup. Tiga
/// pekerjaan sekaligus:
///   1. Anti-dobel. Unik (id_klien, id_property) — aturan "jangan kirim aset
///      yang sama dua kali" ditegakkan database, jadi klik ganda, dua tab, dan
///      dua agent yang memegang klien sama tidak bisa menembusnya.
///   2. Titik banding. Snapshot harga saat kirim adalah SATU-SATUNYA dasar
///      kalimat "harganya turun" — tanpa itu sistem cuma menebak.
///   3. Umpan balik. Tanggapan klien (suka / tidak cocok / minta survei / deal)
///      berikut alasannya adalah data paling berharga di seluruh CRM ini.
/// Butuh migrasi manual — prisma/migration_rekomendasi_klien.sql.
model KirimanRekomendasi {
  id_kiriman    BigInt  @id @default(autoincrement())
  id_klien      String  @db.VarChar(20)
  id_property   BigInt
  id_agent      String  @db.VarChar(20)
  /// Preferensi yang melahirkan kiriman ini. Boleh yatim: preferensi kerap
  /// dihapus saat kriteria klien berubah, sementara fakta "aset ini pernah
  /// dikirim" tidak boleh ikut hilang.
  id_preferensi BigInt?
  kanal         String  @default("WHATSAPP") @db.VarChar(20)

  harga_saat_kirim  Decimal              @db.Decimal(20, 2)
  status_saat_kirim status_properti_enum
  /// Harga yang TERAKHIR DIKETAHUI KLIEN — bergerak setiap kali agent
  /// meneruskan kabar perubahan. Dipisahkan dari harga_saat_kirim supaya aset
  /// yang turun tiga kali tidak selamanya dilaporkan sebagai "turun dari harga
  /// pertama".
  harga_diketahui   Decimal              @db.Decimal(20, 2)

  jumlah_kirim     Int      @default(1)
  pertama_dikirim  DateTime @default(now()) @db.Timestamptz(6)
  terakhir_dikirim DateTime @default(now()) @db.Timestamptz(6)

  tanggapan        tanggapan_kiriman_enum @default(MENUNGGU)
  tanggapan_pada   DateTime?              @db.Timestamptz(6)
  alasan_tanggapan String?

  klien      Klien              @relation(fields: [id_klien], references: [id_klien], onDelete: Cascade, map: "kiriman_klien_fk")
  listing    Listing            @relation(fields: [id_property], references: [id_property], onDelete: Cascade, map: "kiriman_listing_fk")
  agent      Agent              @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade, map: "kiriman_agent_fk")
  preferensi PreferensiKlien?   @relation(fields: [id_preferensi], references: [id_preferensi], onDelete: SetNull, map: "kiriman_pref_fk")
  perubahan  PerubahanKiriman[]

  @@unique([id_klien, id_property], map: "kiriman_unik")
  @@index([id_klien, terakhir_dikirim(sort: Desc)], map: "idx_kiriman_klien")
  @@index([id_agent, terakhir_dikirim(sort: Desc)], map: "idx_kiriman_agent")
  @@index([id_property], map: "idx_kiriman_listing")
  @@map("kiriman_rekomendasi")
}

/// Penilaian agent bahwa sebuah aset TIDAK cocok untuk seorang klien, dengan
/// alasan yang tidak punya kolom di preferensi (menghadap makam, sertifikat
/// bersengketa, klien sudah pernah melihatnya). Tanpa tabel ini aset yang sama
/// naik ke puncak daftar setiap kali layar dibuka, sampai agent berhenti
/// membaca daftarnya sama sekali — dan aset baru ikut terlewat.
///
/// Dikecualikan dari SELURUH pencarian rekomendasi klien itu lewat
/// `src/lib/klienPengecualian.ts` — satu pintu, supaya layar CRM, panel
/// ringkasan, dan cron email tidak bisa menyimpang.
/// Butuh migrasi manual — prisma/migration_rekomendasi_disingkirkan.sql.
model RekomendasiDisingkirkan {
  id          BigInt   @id @default(autoincrement())
  id_klien    String   @db.VarChar(20)
  id_property BigInt
  /// Jejak siapa yang memutuskan — BUKAN bagian dari kuncinya. Penilaiannya
  /// melekat pada pasangan klien–aset, dan klien bisa berpindah tangan.
  id_agent    String   @db.VarChar(20)
  alasan      String?
  dibuat_pada DateTime @default(now()) @db.Timestamptz(6)

  klien   Klien   @relation(fields: [id_klien], references: [id_klien], onDelete: Cascade, map: "disingkirkan_klien_fk")
  listing Listing @relation(fields: [id_property], references: [id_property], onDelete: Cascade, map: "disingkirkan_listing_fk")
  agent   Agent   @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade, map: "disingkirkan_agent_fk")

  @@unique([id_klien, id_property], map: "disingkirkan_unik")
  @@index([id_property], map: "idx_disingkirkan_listing")
  @@map("rekomendasi_disingkirkan")
}

/// Antrean kabar: apa yang berubah pada aset yang SUDAH terlanjur dikirim.
/// Harga turun adalah peluang; terjual adalah kabar buruk yang harus sampai ke
/// klien sebelum ia menanyakannya sendiri. Keduanya sama pentingnya.
/// Butuh migrasi manual — prisma/migration_rekomendasi_klien.sql.
model PerubahanKiriman {
  id             BigInt                       @id @default(autoincrement())
  id_kiriman     BigInt
  jenis          jenis_perubahan_kiriman_enum
  harga_lama     Decimal?                     @db.Decimal(20, 2)
  harga_baru     Decimal?                     @db.Decimal(20, 2)
  selisih_persen Decimal?                     @db.Decimal(7, 2)

  terdeteksi_pada DateTime  @default(now()) @db.Timestamptz(6)
  /// Agent sudah meneruskan kabar ini ke klien.
  diteruskan_pada DateTime? @db.Timestamptz(6)
  /// Agent sengaja melewatinya (mis. naik 1%, tidak layak diganggu).
  /// Dipisahkan dari diteruskan_pada supaya "sudah dikerjakan" bisa dibedakan
  /// dari "sengaja dilewati" saat menilai apakah asisten ini membantu atau
  /// justru berisik.
  diabaikan_pada  DateTime? @db.Timestamptz(6)

  kiriman KirimanRekomendasi @relation(fields: [id_kiriman], references: [id_kiriman], onDelete: Cascade, map: "perubahan_kiriman_fk")

  @@index([id_kiriman, terdeteksi_pada(sort: Desc)], map: "idx_perubahan_kiriman")
  @@map("perubahan_kiriman")
}

model PropertyTitip {
  id_titip BigInt @id @default(autoincrement())

  jenis_properti jenis_properti_titip_enum
  alamat_lengkap String
  provinsi       String                    @db.VarChar(100)
  kota           String                    @db.VarChar(100)
  kecamatan      String?                   @db.VarChar(100)
  kelurahan      String?                   @db.VarChar(100)
  latitude       Decimal?                  @db.Decimal(10, 8)
  longitude      Decimal?                  @db.Decimal(11, 8)
  estimasi_harga Decimal?                  @db.Decimal(20, 2)

  pengirim_nama      String                        @db.VarChar(150)
  pengirim_phone     String                        @db.VarChar(20)
  status_kepemilikan status_kepemilikan_titip_enum

  status             status_titip_enum @default(pending)
  diklaim_oleh_agent String?           @db.VarChar(20)
  diklaim_pada       DateTime?         @db.Timestamptz(6)
  kedaluwarsa_pada   DateTime          @default(dbgenerated("(now() + interval '48 hours')")) @db.Timestamptz(6)

  ip_address String? @db.Inet
  user_agent String?
  session_id String? @db.VarChar(64)
  referrer   String?

  dibuat_pada     DateTime @default(now()) @db.Timestamptz(6)
  diperbarui_pada DateTime @default(now()) @db.Timestamptz(6)

  agent      Agent?                      @relation("PropertyTitipKlaim", fields: [diklaim_oleh_agent], references: [id_agent], onDelete: SetNull, map: "property_titip_agent_fk")
  distribusi PropertyTitipDistribution[]

  @@index([status], map: "idx_property_titip_status")
  @@index([kedaluwarsa_pada], map: "idx_property_titip_expires")
  @@index([dibuat_pada(sort: Desc)], map: "idx_property_titip_created")
  @@index([pengirim_phone], map: "idx_property_titip_phone")
  @@index([diklaim_oleh_agent], map: "idx_property_titip_agent")
  @@map("property_titip")
}

model PropertyTitipDistribution {
  id            BigInt                         @id @default(autoincrement())
  id_titip      BigInt
  id_agent      String                         @db.VarChar(20)
  status        status_titip_distribution_enum @default(pending)
  direspon_pada DateTime?                      @db.Timestamptz(6)
  dibuat_pada   DateTime                       @default(now()) @db.Timestamptz(6)

  titip PropertyTitip @relation(fields: [id_titip], references: [id_titip], onDelete: Cascade, map: "property_titip_distribution_titip_fk")
  agent Agent         @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade, map: "property_titip_distribution_agent_fk")

  @@unique([id_titip, id_agent], map: "property_titip_distribution_unique")
  @@index([id_agent, status], map: "idx_titip_dist_agent_status")
  @@index([id_titip], map: "idx_titip_dist_titip")
  @@map("property_titip_distribution")
}

/// Target komisi bulanan per agent. Diisi oleh agent sendiri atau owner.
/// Dipakai untuk card "Target vs Realisasi" — perbandingan target tetap
/// vs aktual yang dihitung on-the-fly dari detail_transaksi.
model TargetAgent {
  id_target       BigInt   @id @default(autoincrement())
  id_agent        String   @db.VarChar(20)
  tahun           Int
  bulan           Int
  target_komisi   Decimal  @db.Decimal(20, 2)
  dibuat_oleh     String   @db.VarChar(20)
  dibuat_pada     DateTime @default(now()) @db.Timestamptz(6)
  diperbarui_pada DateTime @default(now()) @db.Timestamptz(6)

  agent Agent @relation("AgentTarget", fields: [id_agent], references: [id_agent], onDelete: Cascade, map: "target_agent_agent_fk")

  @@unique([id_agent, tahun, bulan], map: "target_agent_unique")
  @@index([id_agent, tahun(sort: Desc), bulan(sort: Desc)], map: "target_agent_agent_period_idx")
  @@map("target_agent")
}

