  @@index([id_agent], map: "idx_acara_agent")
  @@index([tipe_acara], map: "idx_acara_tipe")
  @@index([tanggal_mulai], map: "idx_acara_tanggal")
  @@index([status_acara], map: "idx_acara_status")
  @@index([id_klien_ref], map: "idx_acara_klien_ref")
  @@map("acara")
}

/// Booking survei properti oleh calon pembeli/penyewa
model BookingSurvei {
  id_booking     BigInt   @id @default(autoincrement())
  id_property    BigInt
  id_agent       String   @db.VarChar(20)
  id_klien       String?  @db.VarChar(20)
  id_lead        BigInt?
  nama_klien     String   @db.VarChar(255)
  nomor_telepon  String   @db.VarChar(20)
  tanggal_survei DateTime @db.Timestamptz(6)
  status         String   @default("PENDING") @db.VarChar(20)
  catatan        String?  @db.Text
  tanggal_dibuat DateTime @default(now()) @db.Timestamptz(6)

  listing  Listing   @relation(fields: [id_property], references: [id_property], onDelete: Cascade)
  agent    Agent     @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade)
  pengguna Pengguna? @relation(fields: [id_klien], references: [id_pengguna], onDelete: SetNull)
  lead     Lead?     @relation(fields: [id_lead], references: [id_lead], onDelete: SetNull)

  @@index([id_agent], map: "idx_booking_survei_agent")
  @@index([id_property], map: "idx_booking_survei_property")
  @@index([id_klien], map: "idx_booking_survei_klien")
  @@index([id_lead], map: "idx_booking_survei_id_lead")
  @@index([tanggal_survei], map: "idx_booking_survei_tanggal")
  @@map("booking_survei")
}

/// Undangan acara — peserta yang di-invite ke sebuah acara di jadwal
/// agent. Berbeda dengan PesertaAcara (yang spesifik buat Pemilu
/// dengan semantic "memilih"), model ini murni untuk visibility
/// kalender: acara hanya tampil di kalender agent kalau dia owner
/// (Acara.id_agent) atau ada di tabel ini.
model UndanganAcara {
  id_undangan     BigInt               @id @default(autoincrement())
  id_acara        BigInt
  id_agent        String               @db.VarChar(20)
  status_undangan status_undangan_enum @default(DIUNDANG)
  diundang_pada   DateTime             @default(now()) @db.Timestamptz(6)
  direspon_pada   DateTime?            @db.Timestamptz(6)
  acara           Acara                @relation(fields: [id_acara], references: [id_acara], onDelete: Cascade)
  agent           Agent                @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade)

  @@unique([id_acara, id_agent])
  @@index([id_agent], map: "idx_undangan_agent")
  @@index([id_acara], map: "idx_undangan_acara")
  @@map("undangan_acara")
}

model PesertaAcara {
  id_peserta          BigInt              @id @default(autoincrement())
  id_acara            BigInt
  id_agent            String              @db.VarChar(20)
  nomor_urut          Int?
  status_peserta      status_peserta_enum @default(TERDAFTAR)
  waktu_daftar        DateTime            @default(now()) @db.Timestamptz(6)
  waktu_mulai_pilih   DateTime?           @db.Timestamptz(6)
  waktu_selesai_pilih DateTime?           @db.Timestamptz(6)
  sisa_waktu          Int?
  acara               Acara               @relation(fields: [id_acara], references: [id_acara], onDelete: Cascade)
  agent               Agent               @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade)

  @@unique([id_acara, id_agent])
  @@index([id_acara], map: "idx_peserta_acara")
  @@index([nomor_urut], map: "idx_peserta_urut")
  @@index([status_peserta], map: "idx_peserta_status")
  @@map("peserta_acara")
}

model PilihanPemilu {
  id_pilihan Int     @default(autoincrement())
  id_acara   BigInt
  id_agent   String  @db.VarChar(20)
  id_listing BigInt
  acara      Acara   @relation(fields: [id_acara], references: [id_acara], onDelete: Cascade)
  agent      Agent   @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade)
  listing    Listing @relation(fields: [id_listing], references: [id_property])

