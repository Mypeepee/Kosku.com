generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pengguna {
  id_pengguna      String           @id @default(dbgenerated("('AC'::text || nextval('pengguna_code_seq'::regclass))")) @db.VarChar(20)
  nama_lengkap     String           @db.VarChar(100)
  email            String?          @unique @db.VarChar(150)
  nomor_telepon    String?          @unique @db.VarChar(20)
  kata_sandi       String?          @db.VarChar(255)
  google_id        String?          @unique @db.VarChar(100)
  kota_asal        String?          @db.VarChar(50)
  tanggal_lahir    DateTime?        @db.Date
  peran            peran_enum       @default(USER)
  status_akun      status_akun_enum @default(AKTIF)
  wa_terverifikasi Boolean          @default(false)
  kode_referral    String?          @db.VarChar(20)
  login_terakhir   DateTime?        @db.Timestamptz(6)
  dibuat_pada      DateTime?        @default(now()) @db.Timestamptz(6)
  diperbarui_pada  DateTime?        @default(now()) @db.Timestamptz(6)
  agent            Agent?
  mouKlien         Mou[]            @relation("MouKlien")
  klien            Klien[]
  bookingSurvei    BookingSurvei[]
  leads            Lead[]
  notifikasi       Notifikasi[]

  @@index([kode_referral], map: "idx_kode_referral")
  @@index([email], map: "idx_pengguna_email")
  @@map("pengguna")
}

model Agent {
  id_agent                String                      @id @default(dbgenerated("('AG'::text || nextval('agent_code_seq'::regclass))")) @db.VarChar(20)
  id_pengguna             String                      @unique(map: "agent_id_pengguna_unique") @db.VarChar(20)
  nama_kantor             String                      @db.VarChar(100)
  kota_area               String                      @db.VarChar(50)
  jabatan                 jabatan_agent_enum          @default(AGENT)
  id_upline               String?                     @db.VarChar(20)
  rating                  Decimal?                    @default(0.00) @db.Decimal(3, 2)
  jumlah_closing          Int                         @default(0)
  total_omset             Decimal?                    @default(0) @db.Decimal(18, 2)
  nomor_whatsapp          String                      @db.VarChar(20)
  poin                    Int                         @default(0)
  foto_ktp_url            String?
  foto_npwp_url           String?
  foto_profil_url         String?
  nama_bank               String?                     @db.VarChar(50)
  nomor_rekening          String?                     @db.VarChar(50)
  atas_nama_rekening      String?                     @db.VarChar(100)
  link_instagram          String?                     @db.VarChar(100)
  link_tiktok             String?                     @db.VarChar(100)
  link_facebook           String?                     @db.VarChar(100)
  status_keanggotaan      status_agent_enum           @default(PENDING)
  tanggal_gabung          DateTime?                   @default(dbgenerated("CURRENT_DATE")) @db.Date
  dibuat_pada             DateTime?                   @default(now()) @db.Timestamptz(6)
  diperbarui_pada         DateTime?                   @default(now()) @db.Timestamptz(6)
  id_team_leader          String?                     @db.VarChar(20)
  acara                   Acara[]
  bookingSurvei           BookingSurvei[]
  pengguna                Pengguna                    @relation(fields: [id_pengguna], references: [id_pengguna], onDelete: Cascade)
  teamLeader              Agent?                      @relation("AgentTeamLeader", fields: [id_team_leader], references: [id_agent])
  teamLeaderMembers       Agent[]                     @relation("AgentTeamLeader")
  upline                  Agent?                      @relation("AgentUpline", fields: [id_upline], references: [id_agent])
  downlines               Agent[]                     @relation("AgentUpline")
  berita                  Berita[]
  detailTransaksi         DetailTransaksi[]
  listings                Listing[]
  penukaranPoin           PenukaranPoin[]
  pesertaAcara            PesertaAcara[]
  pilihanPemilu           PilihanPemilu[]
  undanganAcara           UndanganAcara[]
  projectDibuat           Project[]
  projectInvestor         ProjectInvestor[]
  projectSelesaiInvestor  ProjectSelesaiInvestor[]
  riwayatPoin             RiwayatPoin[]
  mouAgent                Mou[]                       @relation("MouAgent")
  leads                   Lead[]
  leadsCobroke            Lead[]                      @relation("LeadCobroke")
  klien                   Klien[]
  propertyTitipKlaim      PropertyTitip[]             @relation("PropertyTitipKlaim")
  propertyTitipDistribusi PropertyTitipDistribution[]
  targetBulanan           TargetAgent[]               @relation("AgentTarget")
  tugas                   Tugas[]
  kiriman                 KirimanRekomendasi[]
  disingkirkan            RekomendasiDisingkirkan[]
  ProspekDiabaikan        ProspekDiabaikan[]
  email_asisten           EmailAsisten[]

  @@index([jabatan], map: "idx_agent_jabatan")
  @@index([nama_kantor], map: "idx_agent_kantor")
  @@index([id_upline], map: "idx_agent_upline")
  @@index([id_team_leader], map: "idx_agent_team_leader")
  @@map("agent")
}

model Listing {
  id_property        BigInt                 @id @default(autoincrement())
  id_agent           String                 @db.VarChar(20)
  judul              String                 @db.VarChar(255)
  slug               String                 @unique(map: "listing_slug_unique") @db.VarChar(300)
  deskripsi          String?
  jenis_transaksi    jenis_transaksi_enum
  kategori           kategori_properti_enum
  vendor             String?                @db.VarChar(200)
  status_tayang      status_properti_enum   @default(TERSEDIA)
  harga              Decimal                @db.Decimal(20, 2)
  harga_per_meter    Decimal?               @db.Decimal(20, 2)
  harga_promo        Decimal?               @db.Decimal(20, 2)
  /// TURUNAN — JANGAN DITULIS DARI APLIKASI. Harga yang benar-benar tampil di
  /// kartu: harga_promo bila diskonnya sah, kalau tidak harga. Diisi otomatis
  /// oleh trigger `trg_listing_harga_efektif` (prisma/migration_harga_efektif.sql)
  /// pada setiap INSERT/UPDATE, jadi nilai apa pun yang dikirim akan ditimpa.
  /// Ada sebagai kolom nyata semata-mata supaya bisa di-ORDER BY & di-index —
  /// "urutkan termurah" harus memakai angka yang dibaca pemakai. Lihat
  /// src/lib/listingSort.ts.
  harga_efektif      Decimal?               @db.Decimal(20, 2)
  tanggal_lelang     DateTime?              @db.Timestamptz(6)
  uang_jaminan       Decimal?               @db.Decimal(20, 2)
  nilai_limit_lelang Decimal?               @db.Decimal(20, 2)
  link               String?                @db.VarChar(500)
  alamat_lengkap     String?                @db.VarChar(500)
  provinsi           String?                @db.VarChar(355)
  kota               String                 @db.VarChar(355)
  kecamatan          String?                @db.VarChar(355)
  kelurahan          String?                @db.VarChar(355)
  latitude           Decimal?               @db.Decimal(10, 8)
  longitude          Decimal?               @db.Decimal(11, 8)
  /// Patokan/akses terdekat, mis. [{tipe:"KAMPUS",nama:"UNAIR",jarak:5,satuan:"MENIT"}].
  /// Faktor keputusan utama penyewa kos ("5 menit ke kampus"). Disimpan
  /// terstruktur (bukan teks bebas) supaya bisa dirender seragam & nanti
  /// dipakai untuk filter "dekat kampus X". Berlaku untuk semua jenis
  /// transaksi — rumah dijual juga relevan ("dekat tol/sekolah").
  akses_terdekat     Json?
  luas_tanah         Decimal?               @db.Decimal(12, 2)
  luas_bangunan      Decimal?               @db.Decimal(12, 2)
  /// TRUE = lot ini bukan properti (kendaraan, mesin, barang bergerak, hewan,
  /// komoditas) atau datanya tidak layak direkomendasikan. Ada karena
  /// `kategori` pada data hasil scraping lelang adalah EMBER TEMPAT LOT ITU
  /// DIAMBIL, bukan jenis asetnya — scraper dijalankan `--kategori Rumah` dan
  /// seluruh lot di putaran itu jadi RUMAH, termasuk sepeda motor dan sapi.
  /// Diisi trigger `trg_listing_bukan_properti`, JANGAN ditulis dari aplikasi;
  /// hakimnya luas, bukan kata di judul (lihat prisma/migration_listing_bukan_properti.sql).
  bukan_properti     Boolean                @default(false)
  /// TRUE = di atas tanahnya ada bangunan, FALSE = tanah kosong, NULL = tidak
  /// bisa disimpulkan. Lapis kedua atas masalah yang sama dengan
  /// `bukan_properti`: barisnya memang properti, tapi BENTUKNYA bukan yang
  /// diminta — 2.467 lot di ember TANAH sebenarnya berikut bangunan, dan 238
  /// lot di ember RUMAH sebenarnya tanah kosong. NULL sengaja tidak pernah
  /// dibuang mesin pencocokan; hanya nilai yang BERTENTANGAN yang dibuang.
  /// Diisi trigger `trg_listing_ada_bangunan`, JANGAN ditulis dari aplikasi
  /// (lihat prisma/migration_listing_ada_bangunan.sql).
  ada_bangunan       Boolean?
  jumlah_lantai      Int                    @default(1)
  kamar_tidur        Int?
  kamar_mandi        Int?
  daya_listrik       Int?
  sumber_air         String?                @db.VarChar(50)
  hadap_bangunan     String?                @db.VarChar(20)
  kondisi_interior   String?                @db.VarChar(50)
  legalitas          sertifikat_enum?
  nomor_legalitas    String?                @db.VarChar(250)
  gambar             String?
  lampiran           String?
  dilihat            Int                    @default(0)
  wa_click_count     Int                    @default(0)
  is_hot_deal        Boolean                @default(false)
  tanggal_dibuat     DateTime?              @default(now()) @db.Timestamptz(6)
  tanggal_diupdate   DateTime?              @default(now()) @db.Timestamptz(6)
  acara              Acara[]
  agent              Agent                  @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade)
  listingBoosts      ListingBoost[]
  pilihanPemilu      PilihanPemilu[]
  project            Project[]
  projectSelesai     ProjectSelesai[]
  mou                Mou[]
  leads              Lead[]
  klien              Klien[]
  tugas              Tugas[]
  bookingSurvei      BookingSurvei[]
  sewaDetail         ListingSewaDetail?
  kamarTipe          ListingKamarTipe[]
  riwayatStatus      RiwayatStatusListing[]
  ketersediaan       ListingKetersediaan[]
  voucher            ListingVoucher[]
  sekitar            ListingSekitar?
  tempatDekat        ListingTempat[]
  kiriman            KirimanRekomendasi[]
  disingkirkan       RekomendasiDisingkirkan[]

  @@index([kota], map: "idx_property_lokasi")
  @@index([jenis_transaksi], map: "idx_property_jenis")
  @@index([id_agent], map: "idx_property_agent")
  @@index([slug], map: "idx_property_slug")
  @@index([status_tayang], map: "idx_property_status")
  @@index([is_hot_deal], map: "idx_property_hot_deal")
  @@index([status_tayang, jenis_transaksi, tanggal_dibuat(sort: Desc)], map: "idx_property_status_jenis_tgl")
  @@index([status_tayang, is_hot_deal, jenis_transaksi], map: "idx_property_status_hot_jenis")
  @@map("listing")
}

/// Hasil pemindaian "apa saja yang ada di sekitar aset ini" — SATU baris per
/// listing, ditulis sekali lalu dipakai selamanya.
///
/// KENAPA ADA. Sebelumnya daftar fasilitas sekitar dicari ulang dari browser
/// SETIAP kali halaman detail dibuka, langsung ke server publik Overpass. Dua
/// akibatnya sama-sama buruk: hasilnya seperti undian (server publik sering
/// menjawab 429/504, dan kegagalannya terlihat sebagai "tidak ada apa-apa di
/// sekitar sini"), dan satu aset yang dilihat seribu kali berarti seribu
/// permintaan untuk jawaban yang tidak pernah berubah. Warung tidak pindah
/// tiap kali halaman dibuka.
///
/// ATURAN ISI. `lengkap` = pemindaian sudah menemukan minimal 3 tempat; hanya
/// baris lengkap yang dianggap jawaban final dan tidak pernah dipindai ulang.
/// Baris yang belum lengkap tetap disimpan — bukan sebagai jawaban, melainkan
/// sebagai catatan percobaan supaya aset di tengah kebun tidak memicu
/// pemindaian baru di setiap kunjungan; ia baru boleh dicoba lagi setelah
/// jeda (lihat JEDA_ULANG_MS di src/lib/nearbyPlaces.server.ts).
///
/// Titiknya ikut disimpan karena tidak selalu berasal dari listing: aset lama
/// & hasil scrape sering tidak punya koordinat, jadi alamatnya di-geocode
/// sekali di server. `sumber_titik` membedakan keduanya supaya UI bisa jujur
/// menyebut titik hasil geocode sebagai perkiraan.
model ListingSekitar {
  id_property   BigInt   @id
  /// Titik yang dipakai saat memindai. NULL berarti alamatnya pun tidak bisa
  /// di-geocode — barisnya murni catatan percobaan.
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  /// LISTING (koordinat dari agent) | GEOCODE (hasil pencarian alamat).
  sumber_titik  String?  @db.VarChar(20)
  /// Radius (meter) yang akhirnya dipakai. Naik bertahap sampai dapat ≥3
  /// tempat, jadi aset pinggiran tidak selalu kosong seperti sebelumnya.
  radius_meter  Int      @default(0)
  jumlah        Int      @default(0)
  lengkap       Boolean  @default(false)
  /// Berapa kali aset ini pernah dipindai. Hanya untuk diagnosa & jeda ulang.
  percobaan     Int      @default(1)
  /// TempatTerdekat[] — lihat src/lib/nearbyPlaces.ts.
  tempat        Json     @default("[]")
  /// TempatTerdekat[] hasil SAPUAN LANDMARK 5 km — kampus, RS, mall, stasiun,
  /// terminal, bandara, pasar, stadion. Dipisah dari `tempat` dengan sengaja:
  /// yang itu daftar "apa yang ada di sekitar" bertajuk "Radius 800 m" untuk
  /// dibaca manusia, dan menyelipkan bandara 4 km ke sana membuat tajuknya
  /// bohong. Kolom ini bahan bakar indeks pencarian "dekat X" — tanpa ia,
  /// kampus 4 km tidak pernah tercatat dan "deket unesa" tidak bisa bekerja.
  landmark      Json     @default("[]")
  /// Seberapa kasar titik yang dipakai: TITIK | ALAMAT | KELURAHAN |
  /// KECAMATAN | KOTA. `sumber_titik` hanya membedakan pin agent dari hasil
  /// geocode; ini membedakan geocode yang menemukan nama jalan dari yang
  /// menyerah di tingkat kota. Peta memakainya untuk berkata jujur, dan
  /// indeks "dekat X" menolak baris berpresisi KOTA.
  presisi_titik String?  @db.VarChar(12)
  dipindai_pada DateTime @default(now()) @db.Timestamptz(6)

  listing Listing @relation(fields: [id_property], references: [id_property], onDelete: Cascade, map: "listing_sekitar_listing_fk")

  @@index([lengkap, dipindai_pada], map: "idx_listing_sekitar_lengkap")
  @@map("listing_sekitar")
}

/// Cache "apa yang ada di sekitar KOORDINAT ini" — lapisan di bawah
/// ListingSekitar. Lihat prisma/migration_sekitar_titik.sql (dijalankan
/// manual per environment).
///
/// KENAPA ADA. ListingSekitar dikunci id_property, dan itu syarat yang tidak
/// selalu bisa dipenuhi. Form tambah properti memindai sebelum listing-nya
/// ada; tanpa tabel ini hasilnya terbuang dan titik yang sama dipindai lagi
/// saat halaman detailnya dibuka. Beberapa unit di gedung yang sama juga
/// berbagi satu titik — dikunci per listing itu jadi banyak pemindaian untuk
/// jawaban yang identik.
///
/// Tidak ada relasi ke Listing: barisnya memang tidak dimiliki listing mana
/// pun, dan tetap berguna setelah listing yang memicunya dihapus.
model SekitarTitik {
  /// "lat,lng" dibulatkan 3 desimal (±110 m) — lihat kunciTitik() di
  /// src/lib/nearbyPlaces.server.ts.
  kunci         String   @id @db.VarChar(32)
  latitude      Decimal  @db.Decimal(10, 8)
  longitude     Decimal  @db.Decimal(11, 8)
  /// Radius (meter) yang akhirnya dipakai; 0 bila pemindaiannya putus.
  radius_meter  Int      @default(0)
  jumlah        Int      @default(0)
  lengkap       Boolean  @default(false)
  /// TempatTerdekat[] — lihat src/lib/nearbyPlaces.ts.
  tempat        Json     @default("[]")
  /// Hasil sapuan landmark 5 km — lihat ListingSekitar.landmark.
  landmark      Json     @default("[]")
  /// TITIK | ALAMAT | KELURAHAN | KECAMATAN | KOTA — lihat ListingSekitar.
  presisi_titik String?  @db.VarChar(12)
  dipindai_pada DateTime @default(now()) @db.Timestamptz(6)

  @@index([dipindai_pada], map: "idx_sekitar_titik_dipindai")
  @@map("sekitar_titik")
}

/// Kamus tempat yang bisa dicari orang — "deket UNESA", "deket RS Soetomo".
///
/// KENAPA ADA. Filter lokasi yang lama menjawab "di mana" secara
/// administratif: provinsi/kota/kecamatan/kelurahan. Itu bukan cara orang
/// mencari tempat tinggal. Nama kelurahan di sekitar UNESA (Lidah Wetan,
/// Jeruk) justru tidak diketahui oleh orang yang paling membutuhkannya —
/// pendatang yang baru diterima kuliah di sana.
///
/// DARI MANA ISINYA. Tidak diimpor massal dari gazetteer nasional, melainkan
/// tumbuh dari dua hal yang sudah terjadi sendiri: hasil pindai
/// `listing_sekitar` (yang jalan sekali saat halaman detail dibuka pertama
/// kali) dan patokan yang diketik agent di `listing.akses_terdekat`.
/// Konsekuensinya disengaja: sebuah tempat masuk kamus HANYA kalau ada aset
/// di dekatnya — jadi saran autocomplete tidak pernah menawarkan tempat yang
/// hasilnya nol, cacat yang selalu muncul pada kamus hasil impor massal.
///
/// Lihat prisma/migration_tempat_landmark.sql (dijalankan manual per
/// environment) dan src/lib/tempat/.
model Tempat {
  id              BigInt   @id @default(autoincrement())
  /// Kunci dedup — dihitung kunciTempat() di src/lib/tempat/normalisasi.ts.
  /// Aturannya beda per jangkauan: LANDMARK dikunci per kota (satu UNESA per
  /// kota walau dipindai dari 50 aset), HARIAN dikunci per koordinat (tiap
  /// cabang Alfamart baris sendiri — digabung per kota, "dekat Alfamart"
  /// berarti "di kota yang ada Alfamart-nya", yaitu semua kota).
  kunci           String   @unique @db.VarChar(220)
  /// Dipakai di URL (?dekat=unesa-surabaya). Stabil — tautan hasil pencarian
  /// tersebar lewat WhatsApp, jadi mengubahnya mematikan tautan orang lain.
  slug            String   @unique @db.VarChar(200)
  nama            String   @db.VarChar(200)
  /// Bentuk yang dicocokkan: huruf kecil, tanpa tanda baca & gelar.
  nama_normal     String   @db.VarChar(200)
  kelas           String   @db.VarChar(24)
  /// LANDMARK (disapu 5 km — orang naik motor) | HARIAN (800 m — jalan kaki).
  jangkauan       String   @db.VarChar(12)
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  kota            String?  @db.VarChar(120)
  provinsi        String?  @db.VarChar(120)
  /// Nama brand ternormalisasi, mis. "mie gacoan" untuk 12 cabangnya. NULL
  /// untuk tempat tunggal. Membuat "deket mie gacoan" berarti "dekat cabang
  /// mana pun" — user tidak dipaksa memilih cabang yang dia tak tahu ada.
  brand_normal    String?  @db.VarChar(120)
  /// TURUNAN, disegarkan penyerap/skrip. Hanya untuk PERINGKAT saran: kalau
  /// "pasar" cocok ke 40 tempat, yang paling banyak asetnya tampil dulu.
  jumlah_listing  Int      @default(0)
  /// PINDAI | PATOKAN | KURATIF.
  sumber          String   @default("PINDAI") @db.VarChar(16)
  dibuat_pada     DateTime @default(now()) @db.Timestamptz(6)
  disegarkan_pada DateTime @default(now()) @db.Timestamptz(6)

  alias   TempatAlias[]
  listing ListingTempat[]

  @@index([jumlah_listing(sort: Desc)], map: "idx_tempat_populer")
  @@index([brand_normal], map: "idx_tempat_brand")
  @@map("tempat")
}

/// Nama lain untuk tempat yang sama — jantung fitur "deket UNESA".
///
/// "UNESA" dan "Universitas Negeri Surabaya" tidak punya kemiripan trigram
/// sama sekali; tidak ada pencocokan fuzzy secanggih apa pun yang bisa
/// menyatukan keduanya. Satu-satunya jalan adalah MENCATAT bahwa keduanya
/// nama yang sama, dan itulah tabel ini.
///
/// `sumber` menentukan bobot saat memeringkat, dari yang paling dipercaya:
/// OSM (tag short_name/alt_name dari pemeta setempat) → KURATIF (daftar
/// tulis-tangan di src/lib/tempat/alias-kuratif.ts) → PATOKAN (nama yang
/// diketik agent) → AKRONIM.
///
/// AKRONIM sengaja paling lemah dan tidak pernah boleh menang: huruf depan
/// "Universitas Negeri Surabaya" adalah "uns", yang justru milik Universitas
/// Sebelas Maret. Berguna untuk "RSUD Dr Soetomo", berbahaya untuk kampus.
model TempatAlias {
  id_tempat    BigInt @db.BigInt
  alias        String @db.VarChar(200)
  alias_normal String @db.VarChar(200)
  sumber       String @db.VarChar(16)

  tempat Tempat @relation(fields: [id_tempat], references: [id], onDelete: Cascade)

  @@id([id_tempat, alias_normal])
  @@map("tempat_alias")
}

/// Indeks terbalik: dari sebuah tempat, ke aset-aset di dekatnya.
///
/// Tanpa tabel ini, "dekat UNESA" harus membongkar kolom JSON di 120 ribu
/// baris setiap kali ada yang mencari. Dengan tabel ini ia sebuah index scan
/// pada (id_tempat, jarak_meter) yang sudah terurut dari yang paling dekat —
/// persis urutan yang ingin dilihat pencarinya.
model ListingTempat {
  id_property BigInt @db.BigInt
  id_tempat   BigInt @db.BigInt
  jarak_meter Int
  /// PINDAI (diukur haversine dari titik aset) | PATOKAN (diketik agent;
  /// satuan MENIT dikonversi 600 m/menit — motor dalam kota ±36 km/jam).
  sumber      String @db.VarChar(12)
  /// Seberapa boleh dipercaya jaraknya: TITIK | ALAMAT | KELURAHAN |
  /// KECAMATAN | PATOKAN. Presisi KOTA sengaja TIDAK PERNAH masuk sini —
  /// titik yang cuma tahu "Kota Surabaya" tidak berhak mengklaim "1,2 km dari
  /// UNESA". Aset seperti itu tetap ketemu lewat filter kota, yang memang
  /// sebatas itu yang diketahui tentangnya.
  presisi     String @db.VarChar(12)

  listing Listing @relation(fields: [id_property], references: [id_property], onDelete: Cascade)
  tempat  Tempat  @relation(fields: [id_tempat], references: [id], onDelete: Cascade)

  @@id([id_property, id_tempat])
  @@index([id_tempat, jarak_meter], map: "idx_listing_tempat_dekat")
  @@index([id_property], map: "idx_listing_tempat_listing")
  @@map("listing_tempat")
}

/// Detail khusus listing SEWA (kos/apartemen/rumah kontrakan dst) — dipisah
/// dari Listing supaya kolom jual/lelang tidak numpuk dengan kolom yang cuma
/// dipakai transaksi sewa. Relasi 1:1 lewat id_property (PK = FK).
model ListingSewaDetail {
  id_property         BigInt                 @id
  // --- Identitas unit (APARTEMEN) ---
  // Apartemen disewakan per unit, dan satu unit hanya bisa disebut dengan
  // benar lewat gedungnya, lantainya, dan nomornya. Tanpa ini, dua listing di
  // gedung yang sama tidak bisa dibedakan penyewa maupun agent — pola yang
  // dipakai Travelio/Jendela360 untuk tiap unit. Nama tower, kalau perlu,
  // ditulis menyatu di nama_gedung ("Educity Apartment Tower Amethyst").
  // Lantai & nomor unit String (bukan Int) karena di lapangan nilainya memang
  // bukan angka murni: "GF", "12A", "Lt. 3 Mezzanine".
  nama_gedung         String?                @db.VarChar(150)
  lantai_unit         String?                @db.VarChar(20)
  nomor_unit          String?                @db.VarChar(30)
  /// Studio / 1BR / 2BR / … — filter nomor satu di situs sewa apartemen.
  tipe_unit           tipe_unit_enum?
  // Harga per durasi — SEWA bisa menawarkan >1 durasi sekaligus (kos umumnya
  // harian/mingguan/bulanan/tahunan dgn harga masing2). durasi_sewa = durasi
  // mana yg jadi "harga utama" ditampilkan di card listing (nilainya disalin
  // ke Listing.harga saat create/update untuk sort & filter generik).
  durasi_sewa         durasi_sewa_enum?
  harga_sewa_harian   Decimal?               @db.Decimal(20, 2)
  harga_sewa_mingguan Decimal?               @db.Decimal(20, 2)
  harga_sewa_bulanan  Decimal?               @db.Decimal(20, 2)
  harga_sewa_tahunan  Decimal?               @db.Decimal(20, 2)
  // Minimal sewa & deposit — syarat booking, bukan atribut fisik kamar
  minimal_sewa_jumlah Int?
  minimal_sewa_satuan durasi_sewa_enum?
  deposit             Decimal?               @db.Decimal(20, 2)
  /// Biaya di luar harga sewa & deposit, mis.
  /// [{nama:"Listrik",nominal:150000,periode:"BULANAN"}].
  /// Ini keluhan nomor satu penyewa kos: harga di iklan bukan yang dibayar.
  /// Disimpan terstruktur (bukan teks bebas) supaya bisa dijumlahkan jadi
  /// "estimasi total bulan pertama" dan dirender seragam di halaman detail.
  biaya_tambahan      Json?
  // Jam check-in/out — hanya bermakna kalau unit ditawarkan harian/mingguan
  // (pola Booking/Agoda). Untuk sewa bulanan/tahunan dibiarkan null.
  jam_check_in        String?                @db.VarChar(10)
  jam_check_out       String?                @db.VarChar(10)
  // Spesifikasi unit — relevan Kos/Apartemen, bukan luas tanah gedung
  luas_kamar          Decimal?               @db.Decimal(12, 2)
  kamar_mandi_tipe    kamar_mandi_tipe_enum?
  termasuk_listrik    Boolean?
  termasuk_air        Boolean?
  akses_24_jam        Boolean?
  jam_malam           String?                @db.VarChar(10)
  // Fasilitas dipisah: yang didapat sendiri di dalam kamar vs yang dipakai
  // bareng penghuni lain — pertanyaan pertama calon penyewa kos.
  fasilitas_kamar     String?
  fasilitas_bersama   String?
  peraturan           String?
  kos_gender          kos_gender_enum?
  kapasitas_penghuni  Int?
  // Ketersediaan kamar — sebuah listing kos mewakili SATU gedung dengan banyak
  // kamar, jadi "tersedia/terjual" saja tidak cukup. total_kamar = kapasitas
  // gedung, diisi agent lewat wizard.
  total_kamar         Int?
  /// TURUNAN — JANGAN DITULIS DARI APLIKASI. Sisa kamar HARI INI, yaitu
  /// total_kamar dikurangi blok aktif di listing_ketersediaan (di-clamp ke
  /// [0, total_kamar] karena listing_sewa_detail_kamar_check menegakkannya).
  /// Ada sebagai kolom nyata semata-mata supaya pill "Sisa N kamar" di card
  /// dan filter daftar listing tidak perlu join & agregat — duplikasi yang
  /// disengaja, sama alasannya dengan Listing.harga_efektif.
  ///
  /// Ditulis ulang oleh src/app/api/listings/_lib/sewa-availability-write.ts
  /// di tiap mutasi blok, dan sekali sehari oleh /api/cron/sewa-ketersediaan
  /// (blok yang mulai/berakhir hari ini mengubah jawaban tanpa ada yang
  /// menekan tombol). Halaman detail TIDAK membaca kolom ini — ia menghitung
  /// langsung dari listing_ketersediaan, supaya cron yang terlewat hanya
  /// membuat card basi, bukan membuat panel booking berbohong.
  kamar_tersedia      Int?
  listing             Listing                @relation(fields: [id_property], references: [id_property], onDelete: Cascade, map: "listing_sewa_detail_listing_fk")

  @@map("listing_sewa_detail")
}

/// Tipe kamar dalam satu listing KOS. Satu gedung kos jarang seragam: dari 10
/// kamar bisa ada 2 kamar mandi dalam yang lebih luas & lebih mahal. Tanpa
/// tabel ini pemilik dipaksa memilih satu luas/harga/jenis kamar mandi untuk
/// seluruh gedung, dan calon penghuni datang survei dengan ekspektasi salah.
///
/// Opsional: kos yang semua kamarnya sama tidak punya baris di sini dan tetap
/// memakai kolom tunggal di ListingSewaDetail (luas_kamar, kamar_mandi_tipe,
/// total_kamar, dst). Kalau baris di sini ADA, kolom agregat di
/// ListingSewaDetail (total_kamar, kamar_tersedia, harga_sewa_*) dihitung
/// ulang dari tabel ini oleh API — lihat src/lib/kosRoomTypes.ts. Duplikasi
/// itu disengaja supaya query daftar/filter listing tidak perlu join & agregat.
model ListingKamarTipe {
  id                  BigInt                 @id @default(autoincrement())
  id_property         BigInt
  nama                String                 @db.VarChar(80)
  /// Urutan tampil, mengikuti urutan yang disusun agent di form.
  urutan              Int                    @default(0)
  jumlah_kamar        Int
  /// TURUNAN dari listing_ketersediaan — lihat catatan lengkap di
  /// ListingSewaDetail.kamar_tersedia. Aturannya identik, hanya cakupannya
  /// yang menyempit ke satu tipe.
  kamar_tersedia      Int                    @default(0)
  luas_kamar          Decimal?               @db.Decimal(12, 2)
  kamar_mandi_tipe    kamar_mandi_tipe_enum?
  kapasitas_penghuni  Int?
  /// Lantai tempat kamar tipe ini berada, mis. "2" atau "Lt. 2 & 3". Penghuni
  /// menanyakannya sebelum survei (naik-turun tangga tiap hari), dan agent
  /// butuh untuk mengarahkan calon penghuni ke kamar yang benar.
  lantai_kamar        String?                @db.VarChar(20)
  /// Nomor kamar milik tipe ini, mis. "A1, A2, A3". Bebas format karena
  /// penomoran kos tidak seragam; gunanya menunjuk kamar saat survei.
  nomor_kamar         String?                @db.VarChar(60)
  harga_sewa_harian   Decimal?               @db.Decimal(20, 2)
  harga_sewa_mingguan Decimal?               @db.Decimal(20, 2)
  harga_sewa_bulanan  Decimal?               @db.Decimal(20, 2)
  harga_sewa_tahunan  Decimal?               @db.Decimal(20, 2)
  /// Fasilitas khas tipe ini saja (mis. AC, water heater) — di luar
  /// fasilitas_kamar di ListingSewaDetail yang berlaku untuk semua tipe.
  fasilitas_kamar     String?
  /// Foto kamar untuk tipe ini. Formatnya CSV URL, SAMA PERSIS dengan
  /// `listing.gambar`, supaya satu parser saja yang dipakai kedua tempat —
  /// walau form hanya meminta satu foto per tipe (calon penghuni butuh tahu
  /// wujud kamarnya; lebih dari satu foto per tipe membuat kartu tipe berubah
  /// jadi galeri kedua yang menutupi perbandingan antar tipe).
  gambar              String?
  catatan             String?                @db.VarChar(255)
  tanggal_dibuat      DateTime?              @default(now()) @db.Timestamptz(6)
  tanggal_diupdate    DateTime?              @default(now()) @db.Timestamptz(6)
  listing             Listing                @relation(fields: [id_property], references: [id_property], onDelete: Cascade, map: "listing_kamar_tipe_listing_fk")
  ketersediaan        ListingKetersediaan[]

  @@index([id_property], map: "idx_listing_kamar_tipe_property")
  @@map("listing_kamar_tipe")
}

/// Jejak audit setiap perubahan `listing.status_tayang` — siapa mengubah, dari
/// status apa ke apa, kapan, dan ATAS DASAR WEWENANG APA.
///
/// Wajib ada sejak status listing bisa diubah dari halaman detail publik oleh
/// tiga pihak berbeda (pemegang listing, OWNER, dan STOKER untuk aset lelang).
/// Tanpa tabel ini, satu-satunya bukti "aset saya ditutup orang lain" adalah
/// kolom tanggal_diupdate yang tidak menyebut pelakunya — pertanyaan "siapa
/// yang menandai listing saya terjual?" jadi mustahil dijawab.
///
/// Identitas pelaku disimpan sebagai SNAPSHOT (id + nama + jabatan saat itu),
/// bukan relasi ke tabel agent. Dua alasan: (1) jabatan berubah — stoker hari
/// ini bisa jadi agent biasa bulan depan, dan audit harus mencatat wewenang
/// yang dipakai SAAT kejadian, bukan wewenang hari ini; (2) baris audit harus
/// selamat walau akun pelakunya dihapus. Karena itu tidak ada foreign key ke
/// agent di sini — hanya ke listing, yang memang tidak berarti lagi kalau
/// listingnya sendiri sudah tidak ada.
///
/// Tabelnya append-only: tidak pernah di-UPDATE maupun di-DELETE oleh aplikasi.
///
/// Butuh migrasi manual — lihat prisma/migration_riwayat_status_listing.sql.
model RiwayatStatusListing {
  id               BigInt               @id @default(autoincrement())
  id_property      BigInt
  /// Pelaku: id_agent yang menekan tombol.
  id_agent         String               @db.VarChar(20)
  /// Snapshot nama pelaku saat kejadian (nama bisa berubah/akun bisa hilang).
  nama_pelaku      String?              @db.VarChar(150)
  /// Snapshot `jabatan_agent_enum` pelaku saat kejadian. String, bukan enum,
  /// supaya nilai jabatan yang kelak dihapus dari enum tetap terbaca di audit.
  jabatan_pelaku   String               @db.VarChar(30)
  /// Dasar izin yang dipakai: OWNER | PEMILIK | STOKER_LELANG.
  /// Inilah yang membedakan "agent menutup listingnya sendiri" dari "stoker
  /// menutup aset agent lain" — dua kejadian yang sangat berbeda bobotnya.
  dasar_wewenang   String               @db.VarChar(20)
  /// Snapshot pemegang listing saat kejadian (listing bisa dialihkan).
  id_agent_pemilik String               @db.VarChar(20)
  status_lama      status_properti_enum
  status_baru      status_properti_enum
  /// Dari mana aksinya datang: DETAIL (halaman detail) | DASHBOARD (aksi massal).
  sumber           String               @db.VarChar(20)
  dibuat_pada      DateTime             @default(now()) @db.Timestamptz(6)

  listing Listing @relation(fields: [id_property], references: [id_property], onDelete: Cascade, map: "riwayat_status_listing_listing_fk")

  @@index([id_property, dibuat_pada(sort: Desc)], map: "idx_riwayat_status_listing_property")
  @@index([id_agent, dibuat_pada(sort: Desc)], map: "idx_riwayat_status_listing_pelaku")
  @@map("riwayat_status_listing")
}

/// Periode sebuah listing SEWA (atau satu tipe kamar di dalamnya) TIDAK
/// tersedia — sumber kebenaran tunggal untuk ketersediaan sewa. Kolom
/// kamar_tersedia di listing_sewa_detail & listing_kamar_tipe adalah TURUNAN
/// dari tabel ini.
///
/// Kenapa interval, bukan satu baris per tanggal? Bahasa pengelola memang
/// interval — "kamar 3 terisi 1 Sep sampai 1 Des" adalah satu baris, satu
/// edit, satu hapus, dan jejak audit yang terbaca. Sewa di sini didominasi
/// bulanan/tahunan, jadi baris-per-tanggal cuma menggelembungkan tabel tanpa
/// menambah satu pun jawaban yang tidak bisa dihitung dari interval.
///
/// Satu model untuk dua bentuk inventaris:
///   • KOS       → pooled; jumlah_kamar bisa >1, id_tipe menunjuk tipe kamar
///                 (atau null bila kos itu tidak memakai tipe sama sekali).
///   • non-KOS   → unit tunggal; id_tipe SELALU null & jumlah_kamar SELALU 1.
/// Apartemen hanyalah kos berkapasitas 1 — memisahkannya jadi dua sistem
/// adalah cara paling pasti mendapat dua himpunan bug untuk satu perhitungan.
model ListingKetersediaan {
  id              BigInt             @id @default(autoincrement())
  id_property     BigInt
  /// null = berlaku untuk seluruh listing (unit tunggal, atau kos tanpa tipe).
  id_tipe         BigInt?
  /// Rentang SETENGAH TERBUKA [tanggal_mulai, tanggal_selesai) — hari
  /// `tanggal_selesai` sudah kosong lagi dan boleh dipakai penghuni berikutnya.
  /// Konvensi ini menyamai useBooking (12 Agu + 8 hari = 20 Agu, "8 hari");
  /// memakai rentang tertutup di sisi data akan membuat kamar tidak bisa
  /// disewakan pada hari penghuni sebelumnya keluar.
  tanggal_mulai   DateTime           @db.Date
  /// null = terbuka, "sampai dibuka lagi" — bentuk penyimpanan dari tombol
  /// "Tandai penuh". Setiap perulangan tanggal atasnya WAJIB di-clamp ke
  /// horizon, kalau tidak ia tidak pernah berhenti.
  tanggal_selesai DateTime?          @db.Date
  jumlah_kamar    Int                @default(1)
  alasan          alasan_blokir_enum @default(DISEWA)
  catatan         String?            @db.VarChar(255)
  /// id_agent yang membuat blok. Bisa OWNER yang memakai wewenangnya atas
  /// listing agent lain, jadi bukan selalu sama dengan listing.id_agent.
  dibuat_oleh     String             @db.VarChar(20)
  dibuat_pada     DateTime           @default(now()) @db.Timestamptz(6)
  diperbarui_pada DateTime           @default(now()) @db.Timestamptz(6)

  listing Listing           @relation(fields: [id_property], references: [id_property], onDelete: Cascade, map: "listing_ketersediaan_listing_fk")
  tipe    ListingKamarTipe? @relation(fields: [id_tipe], references: [id], onDelete: Cascade, map: "listing_ketersediaan_tipe_fk")

  @@index([id_property, tanggal_mulai, tanggal_selesai], map: "idx_ketersediaan_property_rentang")
  @@index([id_tipe], map: "idx_ketersediaan_tipe")
  @@map("listing_ketersediaan")
}

/// Voucher potongan sewa milik SATU listing, dibuat sendiri oleh agent
/// pemegangnya lewat panel kontrol di halaman detail.
///
/// Sengaja TIDAK ada voucher global lintas listing. Potongan harga sewa
/// dibayar oleh pemilik aset, bukan oleh platform — jadi hanya dia yang boleh
/// memutuskan besarnya, dan hanya untuk asetnya sendiri. Voucher global akan
/// memotong pendapatan orang yang tidak pernah menyetujuinya.
model ListingVoucher {
  id          BigInt @id @default(autoincrement())
  id_property BigInt

  /// Huruf besar tanpa spasi. Unik PER LISTING, bukan global: dua pemilik yang
  /// berbeda boleh sama-sama memakai "HEMAT10" untuk asetnya masing-masing,
  /// dan memaksakan keunikan global hanya akan membuat pemilik kedua ditolak
  /// tanpa sebab yang bisa dia lihat.
  kode      String  @db.VarChar(30)
  nama      String  @db.VarChar(120)
  deskripsi String? @db.VarChar(300)

  jenis         jenis_voucher_enum @default(NOMINAL)
  /// PERSEN → dibaca 0–100. NOMINAL → dibaca rupiah.
  nilai         Decimal            @db.Decimal(14, 2)
  /// Batas atas potongan untuk jenis PERSEN. null = tanpa batas.
  potongan_maks BigInt?
  /// Subtotal sewa minimum (deposit TIDAK ikut dihitung — lihat @/lib/voucher).
  min_transaksi BigInt?

  /// Kosong = berlaku untuk semua durasi yang ditawarkan listing.
  durasi_berlaku durasi_sewa_enum[]
  /// Id `listing_kamar_tipe` yang dilayani. Kosong = semua tipe.
  ///
  /// Sengaja tanpa foreign key (Postgres tidak bisa memasangnya per elemen
  /// array, dan itu justru menguntungkan di sini): kalau tipe kamarnya dihapus,
  /// id yang tertinggal tidak akan cocok dengan tipe mana pun sehingga
  /// vouchernya BERHENTI cair — gagal-tertutup. Membersihkan id yang hilang
  /// sampai arraynya kosong akan diam-diam mengubah promo "khusus Standard"
  /// jadi promo untuk seluruh tipe, termasuk yang termahal.
  tipe_berlaku   BigInt[]
  /// Lama sewa minimum dalam satuan durasinya.
  lama_min       Int?
  /// Inklusif — voucher belum hidup SEBELUM tanggal ini. NULL = hidup sejak
  /// dibuat. Adanya kolom ini yang membuat promo bisa disiapkan jauh hari:
  /// tanpa itu, satu-satunya cara memasang promo untuk minggu depan adalah
  /// mengingat sendiri untuk membuatnya minggu depan.
  berlaku_mulai  DateTime?          @db.Date
  /// Inklusif — voucher masih hidup pada tanggal ini.
  berlaku_sampai DateTime?          @db.Date

  /// Batas jumlah pemakaian. NULL = tanpa batas.
  ///
  /// Alat promosi, bukan sekadar pengaman: "sisa 5 dari 20" adalah alasan
  /// penyewa memutuskan hari ini. Sekaligus batas kerugian yang bisa
  /// dianggarkan pemilik di muka — promo tanpa kuota tidak punya angka
  /// terbesar.
  kuota_total    Int?
  /// Counter, BUKAN COUNT(*) ke listing_voucher_pakai. Alasannya penguncian,
  /// bukan kecepatan: penambahannya lewat satu UPDATE bersyarat (lihat
  /// prisma/migration_listing_voucher_v2.sql) aman dari dua penyewa yang
  /// menebus jatah terakhir pada detik yang sama.
  kuota_terpakai Int  @default(0)

  /// Dimatikan sementara tanpa dihapus: pemilik sering menghidupkan promo yang
  /// sama tiap musim, dan menghapusnya berarti mengetik ulang seluruh syarat.
  aktif   Boolean @default(true)
  /// Tidak pernah muncul di daftar publik; hanya keluar bila kodenya diketik
  /// persis. Untuk promo tertutup (kerja sama kampus, kode influencer).
  rahasia Boolean @default(false)

  /// id_agent pembuat. Bisa OWNER yang memakai wewenangnya atas listing agent
  /// lain, jadi tidak selalu sama dengan listing.id_agent.
  dibuat_oleh     String   @db.VarChar(20)
  dibuat_pada     DateTime @default(now()) @db.Timestamptz(6)
  diperbarui_pada DateTime @default(now()) @db.Timestamptz(6)

  listing Listing               @relation(fields: [id_property], references: [id_property], onDelete: Cascade, map: "listing_voucher_listing_fk")
  pakai   ListingVoucherPakai[]

  @@unique([id_property, kode], map: "uq_listing_voucher_kode")
  @@index([id_property, aktif], map: "idx_listing_voucher_property_aktif")
  @@map("listing_voucher")
}

/// Satu baris per pemakaian voucher.
///
/// `kuota_terpakai` menjawab "berapa sisa"; tabel ini menjawab "promo mana
/// yang sebenarnya menghasilkan". Tanpa itu pemilik hanya bisa menebak —
/// voucher yang tidak pernah dipakai dan yang dipakai 30 kali terlihat sama
/// persis di daftar.
///
/// Angka pemesanannya DIBEKUKAN di sini, tidak dibaca ulang dari vouchernya:
/// besaran promo boleh diubah kapan saja, dan riwayat yang ikut berubah
/// ketika syaratnya diubah bukan riwayat.
model ListingVoucherPakai {
  id          BigInt @id @default(autoincrement())
  id_voucher  BigInt
  id_property BigInt

  /// Disalin, bukan hanya di-join: kode inilah yang dilihat pemilik di
  /// riwayat, dan kode voucher boleh diubah setelah dipakai.
  kode          String  @db.VarChar(30)
  nama_klien    String? @db.VarChar(160)
  telepon_klien String? @db.VarChar(32)

  /// Subtotal sewa saat itu (tanpa deposit) & rupiah yang benar-benar dipotong.
  subtotal BigInt            @default(0)
  potongan BigInt            @default(0)
  durasi   durasi_sewa_enum?
  lama     Int?

  dipakai_pada DateTime @default(now()) @db.Timestamptz(6)

  voucher ListingVoucher @relation(fields: [id_voucher], references: [id], onDelete: Cascade, map: "listing_voucher_pakai_voucher_fk")

  @@index([id_voucher, dipakai_pada(sort: Desc)], map: "idx_listing_voucher_pakai_voucher")
  @@map("listing_voucher_pakai")
}

/// PERSEN dibatasi `potongan_maks`; NOMINAL tidak perlu. Dipisah sebagai enum,
/// bukan ditebak dari besar `nilai` (mis. "≤100 berarti persen"), karena
/// potongan Rp 50 memang mustahil tapi bukan tugas skema untuk menebaknya.
enum jenis_voucher_enum {
  PERSEN
  NOMINAL
}

/// Kenapa sebuah kamar/unit ditandai tidak tersedia. Bukan hiasan: "DISEWA"
/// adalah kamar yang menghasilkan uang, "RENOVASI" adalah kamar yang tidak —
/// dan hanya yang pertama yang boleh dianggap lead yang sudah tertutup.
/// Nilainya TIDAK pernah dikirim ke pengunjung publik (informasi operasional).
enum alasan_blokir_enum {
  DISEWA
  RENOVASI
  DIPAKAI_SENDIRI
  TUTUP
}

model Project {
  id_project             String               @id @default(dbgenerated("('FLP'::text || lpad((nextval('project_code_seq'::regclass))::text, 4, '0'::text))")) @db.VarChar(20)
  id_listing             BigInt
  nama_project           String               @db.VarChar(255)
  alamat_property        String?              @db.VarChar(500)
  provinsi               String?              @db.VarChar(355)
  kota                   String?              @db.VarChar(355)
  kecamatan              String?              @db.VarChar(355)
  kelurahan              String?              @db.VarChar(355)
  gambar_thumbnail       String?              @db.VarChar(500)
  tanggal_pembelian      DateTime?            @db.Date
  harga_pembelian        Decimal              @default(0) @db.Decimal(20, 2)
  estimasi_harga_jual    Decimal              @default(0) @db.Decimal(20, 2)
  estimasi_profit_bersih Decimal              @default(0) @db.Decimal(20, 2)
  target_pendanaan       Decimal              @default(0) @db.Decimal(20, 2)
  total_pendanaan        Decimal              @default(0) @db.Decimal(20, 2)
  jenis_pendanaan        jenis_pendanaan_enum
  status                 status_project_enum  @default(pendanaan_terbuka)
  mulai_tanggal          DateTime?            @db.Date
  estimasi_selesai       DateTime?            @db.Date
  estimasi_bulan         Int                  @default(0)
  pendanaan_ditutup_pada DateTime?            @db.Date
  deskripsi_project      String?
  dibuat_oleh            String               @db.VarChar(20)
  nilai_limit_lelang     Decimal              @default(0) @db.Decimal(20, 2)
  spare_bidding          Decimal              @default(0) @db.Decimal(20, 2)
  biaya_eksekusi         Decimal              @default(0) @db.Decimal(20, 2)
  biaya_renov            Decimal              @default(0) @db.Decimal(20, 2)
  biaya_balik_nama       Decimal              @default(0) @db.Decimal(20, 2)
  total_biaya_akuisisi   Decimal              @default(0) @db.Decimal(20, 2)
  dana_cadangan          Decimal              @default(0) @db.Decimal(20, 2)
  dibuat_tanggal         DateTime             @default(now()) @db.Timestamptz(6)
  diupdate_tanggal       DateTime             @default(now()) @db.Timestamptz(6)
  pembuat                Agent                @relation(fields: [dibuat_oleh], references: [id_agent], map: "project_dibuat_oleh_fk")
  listing                Listing              @relation(fields: [id_listing], references: [id_property], map: "project_listing_fk")
  arusKas                ProjectArusKas[]
  cmaEntries             ProjectCma[]
  investorProject        ProjectInvestor[]
  projectSelesai         ProjectSelesai[]
  units                  ProjectUnit[]

  @@index([id_listing], map: "idx_project_listing")
  @@index([dibuat_oleh], map: "idx_project_dibuat_oleh")
  @@index([status], map: "idx_project_status")
  @@index([jenis_pendanaan], map: "idx_project_jenis_pendanaan")
  @@index([kota], map: "idx_project_kota")
  @@map("project")
}

model ProjectInvestor {
  id_project_investor    BigInt                         @id @default(autoincrement())
  id_project             String                         @db.VarChar(20)
  id_agent               String                         @db.VarChar(20)
  nominal_komitmen       Decimal                        @default(0) @db.Decimal(20, 2)
  nominal_terbayar       Decimal                        @default(0) @db.Decimal(20, 2)
  persentase_kepemilikan Decimal?                       @db.Decimal(10, 6)
  status                 status_pembayaran_project_enum @default(menunggu_pembayaran)
  dibuat_tanggal         DateTime                       @default(now()) @db.Timestamptz(6)
  diupdate_tanggal       DateTime                       @updatedAt @db.Timestamptz(6)
  agent                  Agent                          @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade, map: "project_investor_agent_fk")
  project                Project                        @relation(fields: [id_project], references: [id_project], onDelete: Cascade, map: "project_investor_project_fk")
  arusKas                ProjectArusKas[]

  @@unique([id_project, id_agent], map: "project_investor_unique")
  @@index([id_project], map: "idx_project_investor_project")
  @@index([id_agent], map: "idx_project_investor_agent")
  @@index([status], map: "idx_project_investor_status")
  @@map("project_investor")
}

/// Unit jual dalam satu project (mis. 2 rumah jejer = 2 unit). bobot_persen =
/// porsi biaya project yang dibebankan ke unit ini; Σ bobot per project = 100.
/// "Terjual" TIDAK disimpan sebagai kolom — diturunkan dari keberadaan baris
/// ProjectSelesai yang menunjuk unit ini (satu sumber kebenaran, anti-desync).
model ProjectUnit {
  id_project_unit  BigInt           @id @default(autoincrement())
  id_project       String           @db.VarChar(20)
  nama_unit        String           @db.VarChar(120)
  bobot_persen     Decimal          @default(0) @db.Decimal(9, 6)
  urutan           Int              @default(0)
  dibuat_tanggal   DateTime         @default(now()) @db.Timestamptz(6)
  diupdate_tanggal DateTime         @updatedAt @db.Timestamptz(6)
  project          Project          @relation(fields: [id_project], references: [id_project], onDelete: Cascade, map: "project_unit_project_fk")
  penjualan        ProjectSelesai[]

  @@unique([id_project, nama_unit], map: "project_unit_nama_unique")
  @@index([id_project], map: "idx_project_unit_project")
  @@map("project_unit")
}

/// Satu baris = satu realisasi penjualan. id_project_unit NULL = penjualan
/// project utuh (legacy / project 1 unit); terisi = penjualan per unit.
/// Unique id_project_unit: satu unit hanya bisa terjual sekali.
model ProjectSelesai {
  id_project_selesai    BigInt                   @id @default(autoincrement())
  id_project            String                   @db.VarChar(20)
  id_project_unit       BigInt?
  id_listing            BigInt
  tanggal_pembelian     DateTime?                @db.Date
  tanggal_terjual       DateTime                 @db.Date
  durasi_hari           Int
  harga_jual            Decimal                  @default(0) @db.Decimal(20, 2)
  total_biaya_akuisisi  Decimal                  @default(0) @db.Decimal(20, 2)
  profit_kotor          Decimal                  @default(0) @db.Decimal(20, 2)
  pph_percent           Decimal                  @default(0) @db.Decimal(5, 2)
  ajb_percent           Decimal                  @default(0) @db.Decimal(5, 2)
  agent_fee_percent     Decimal                  @default(0) @db.Decimal(5, 2)
  /// Nominal fee EKSAK. Bisa manual (nilai akta ≠ harga riil utk PPh/AJB);
  /// percent di atas hanya referensi turunan. Sumber kebenaran = nominal.
  pph_nominal           Decimal                  @default(0) @db.Decimal(20, 2)
  ajb_nominal           Decimal                  @default(0) @db.Decimal(20, 2)
  agent_fee_nominal     Decimal                  @default(0) @db.Decimal(20, 2)
  total_biaya_transaksi Decimal                  @default(0) @db.Decimal(20, 2)
  profit_bersih         Decimal                  @default(0) @db.Decimal(20, 2)
  roi_bersih            Decimal                  @default(0) @db.Decimal(10, 2)
  dibuat_tanggal        DateTime                 @default(now()) @db.Timestamptz(6)
  diupdate_tanggal      DateTime                 @updatedAt @db.Timestamptz(6)
  listing               Listing                  @relation(fields: [id_listing], references: [id_property], map: "project_selesai_listing_fk")
  project               Project                  @relation(fields: [id_project], references: [id_project], onDelete: Cascade, map: "project_selesai_project_fk")
  unit                  ProjectUnit?             @relation(fields: [id_project_unit], references: [id_project_unit], onDelete: Restrict, map: "project_selesai_unit_fk")
  investorSelesai       ProjectSelesaiInvestor[]

  @@unique([id_project_unit], map: "project_selesai_unit_unique")
  @@index([id_project], map: "idx_project_selesai_project")
  @@index([id_listing], map: "idx_project_selesai_listing")
  @@index([tanggal_terjual], map: "idx_project_selesai_tanggal_terjual")
  @@map("project_selesai")
}

model ProjectSelesaiInvestor {
  id_project_selesai BigInt
  id_project         String         @db.VarChar(20)
  id_agent           String         @db.VarChar(20)
  modal              Decimal        @default(0) @db.Decimal(20, 2)
  porsi_percent      Decimal        @default(0) @db.Decimal(10, 6)
  profit             Decimal        @default(0) @db.Decimal(20, 2)
  total_diterima     Decimal        @default(0) @db.Decimal(20, 2)
  agent              Agent          @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade, map: "project_selesai_investor_agent_fk")
  projectSelesai     ProjectSelesai @relation(fields: [id_project_selesai], references: [id_project_selesai], onDelete: Cascade, map: "project_selesai_investor_selesai_fk")

  @@id([id_project_selesai, id_agent])
  @@index([id_agent], map: "idx_project_selesai_investor_agent")
  @@index([id_project], map: "idx_project_selesai_investor_project")
  @@map("project_selesai_investor")
}

model ProjectCma {
  id_project_cma   BigInt   @id @default(autoincrement())
  id_project       String   @db.VarChar(20)
  nama             String   @db.VarChar(255)
  luas_tanah       Decimal  @default(0) @db.Decimal(12, 2)
  harga            Decimal  @default(0) @db.Decimal(20, 2)
  catatan          String?
  dibuat_tanggal   DateTime @default(now()) @db.Timestamptz(6)
  diupdate_tanggal DateTime @default(now()) @db.Timestamptz(6)
  project          Project  @relation(fields: [id_project], references: [id_project], onDelete: Cascade, map: "project_cma_project_fk")

  @@index([id_project], map: "idx_project_cma_project")
  @@map("project_cma")
}

model ProjectArusKas {
  id_project_arus_kas BigInt                 @id @default(autoincrement())
  id_project          String                 @db.VarChar(20)
  tanggal_transaksi   DateTime               @db.Date
  jenis_transaksi     jenis_arus_kas_enum
  kategori_transaksi  kategori_arus_kas_enum
  judul_transaksi     String                 @db.VarChar(255)
  nominal             Decimal                @default(0) @db.Decimal(20, 2)
  status_transaksi    status_arus_kas_enum   @default(tercatat)
  catatan             String?
  dibuat_tanggal      DateTime               @default(now()) @db.Timestamptz(6)
  diupdate_tanggal    DateTime               @updatedAt @db.Timestamptz(6)
  wallet_key          wallet_key_enum
  id_project_investor BigInt?
  id_arus_kas_terkait BigInt?
  project             Project                @relation(fields: [id_project], references: [id_project], onDelete: Cascade, map: "project_arus_kas_project_fk")
  investor            ProjectInvestor?       @relation(fields: [id_project_investor], references: [id_project_investor], onDelete: SetNull, map: "project_arus_kas_investor_fk")

  @@index([id_project], map: "idx_project_arus_kas_project")
  @@index([id_project_investor], map: "idx_project_arus_kas_investor")
  @@index([id_arus_kas_terkait], map: "idx_project_arus_kas_terkait")
  @@index([wallet_key], map: "idx_project_arus_kas_wallet")
  @@index([tanggal_transaksi], map: "idx_project_arus_kas_tanggal")
  @@index([jenis_transaksi], map: "idx_project_arus_kas_jenis")
  @@index([kategori_transaksi], map: "idx_project_arus_kas_kategori")
  @@index([status_transaksi], map: "idx_project_arus_kas_status")
  @@index([id_project, wallet_key, tanggal_transaksi], map: "idx_project_arus_kas_project_wallet_tanggal")
  @@map("project_arus_kas")
}

// ── MOU: data pra-closing (dibuat saat buat transaksi) ───────────────────────
model Mou {
  id                    BigInt               @id @default(autoincrement())
  id_transaksi          String?              @unique @db.VarChar(50)
  id_listing            BigInt
  id_agent              String               @db.VarChar(20)
  id_klien              String?              @db.VarChar(20)
  jenis_transaksi       jenis_transaksi_enum
  tipe_komisi           String               @db.VarChar(50)
  gambar_ktp_klien      String?
  nama_lengkap_klien    String?              @db.VarChar(200)
  nik_klien             String?              @db.VarChar(20)
  alamat_klien          String?
  harga_deal            BigInt?
  harga_limit           Decimal?             @db.Decimal(20, 2)
  persentase_komisi     Decimal?             @db.Decimal(10, 6)
  biaya_baliknama       BigInt?
  biaya_pengosongan     BigInt?
  termasuk_baliknama    Boolean              @default(false)
  termasuk_pengosongan  Boolean              @default(false)
  maksimum_bidding      Decimal?             @db.Decimal(20, 2)
  agent_luar_nama       String?              @db.VarChar(100)
  agent_luar_kantor     String?              @db.VarChar(100)
  agent_luar_telepon    String?              @db.VarChar(20)
  tanggal_transaksi     DateTime?            @db.Date
  status                status_mou_enum      @default(proses)
  mou_generated         Boolean              @default(false)
  invoice_utm_generated Boolean              @default(false)
  dibuat_pada           DateTime             @default(now()) @db.Timestamptz(6)
  diperbarui_pada       DateTime             @default(now()) @db.Timestamptz(6)
  listing               Listing              @relation(fields: [id_listing], references: [id_property], map: "mou_listing_fk")
  agent                 Agent                @relation("MouAgent", fields: [id_agent], references: [id_agent], map: "mou_agent_fk")
  klien                 Pengguna?            @relation("MouKlien", fields: [id_klien], references: [id_pengguna], map: "mou_klien_fk")
  transaksi             Transaksi?

  @@index([id_listing], map: "mou_listing_idx")
  @@index([id_agent], map: "mou_agent_idx")
  @@map("mou")
}

// ── Transaksi: data realisasi closing (dibuat setelah closing dikonfirmasi) ───
model Transaksi {
  id_transaksi             String                @id @db.VarChar(50)
  harga_bidding            Decimal?              @db.Decimal(20, 2)
  selisih                  BigInt?
  kenaikan_dari_limit      Decimal?              @db.Decimal(10, 6)
  biaya_baliknama          BigInt?
  biaya_pengosongan        BigInt?
  cobroke_fee              BigInt                @default(0)
  tanggal_transaksi        DateTime              @db.Date
  rating                   Int?
  comment                  String?               @db.VarChar(250)
  catatan                  String?
  pendapatan_bersih_kantor BigInt                @default(0)
  thc_agent                BigInt                @default(0)
  status_transaksi         status_transaksi_enum @default(closing)
  dibuat_pada              DateTime              @default(now()) @db.Timestamptz(6)
  diperbarui_pada          DateTime              @default(now()) @db.Timestamptz(6)
  mou                      Mou                   @relation(fields: [id_transaksi], references: [id_transaksi], map: "transaksi_mou_fk")
  detail                   DetailTransaksi[]
  invoice                  Invoice[]
  tugas                    Tugas[]

  @@index([tanggal_transaksi], map: "transaksi_date_idx")
  @@map("transaksi")
}

model DetailTransaksi {
  id           BigInt    @id @default(autoincrement())
  id_transaksi String    @db.VarChar(50)
  id_agent     String    @db.VarChar(50)
  role         String    @db.VarChar(50)
  pendapatan   BigInt
  agent        Agent     @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade, map: "detail_transaksi_agent_fk")
  transaksi    Transaksi @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: Cascade, map: "detail_transaksi_trans_fk")

  @@unique([id_transaksi, id_agent, role], map: "detail_transaksi_unique_per_role")
  @@index([id_agent], map: "detail_transaksi_agent_idx")
  @@index([id_transaksi], map: "detail_transaksi_trans_idx")
  @@map("detail_transaksi")
}

model Invoice {
  id_invoice       String    @id @db.VarChar(50)
  id_kuitansi      String?   @db.VarChar(50)
  id_transaksi     String    @db.VarChar(50)
  ditagihkan_ke    String    @db.VarChar(255)
  keterangan       String
  nominal          BigInt
  tanggal_invoice  DateTime  @db.Timestamptz(6)
  tanggal_kuitansi DateTime? @db.Timestamptz(6)
  transaksi        Transaksi @relation(fields: [id_transaksi], references: [id_transaksi], map: "invoice_transaksi_fk")

  @@index([id_transaksi], map: "idx_invoice_transaksi")
  @@index([tanggal_invoice], map: "idx_invoice_tanggal")
  @@map("invoice")
}

model ListingBoost {
  id_boost        BigInt   @id @default(autoincrement())
  id_listing      BigInt
  jenis_boost     String   @db.VarChar(30)
  sumber          String   @db.VarChar(30)
  tanggal_mulai   DateTime @db.Timestamptz(6)
  tanggal_selesai DateTime @db.Timestamptz(6)
  status          String   @default("SCHEDULED") @db.VarChar(20)
  tanggal_dibuat  DateTime @default(now()) @db.Timestamptz(6)
  listing         Listing  @relation(fields: [id_listing], references: [id_property], onDelete: Cascade, map: "listing_boost_listing_fk")

  @@index([id_listing], map: "listing_boost_listing_idx")
  @@index([status])
  @@index([tanggal_mulai, tanggal_selesai], map: "listing_boost_time_idx")
  @@map("listing_boost")
}

model Berita {
  id_berita        BigInt             @id @default(autoincrement())
  id_agent         String?            @db.VarChar(20)
  judul            String             @db.VarChar(255)
  slug             String             @unique @db.VarChar(300)
  ringkasan        String?            @db.VarChar(500)
  isi_berita       String
  gambar_utama     String?            @db.VarChar(500)
  galeri_gambar    String?
  kategori         String             @db.VarChar(50)
  tag              String?            @db.VarChar(255)
  penulis          String             @db.VarChar(100)
  sumber_berita    String?            @db.VarChar(200)
  status_publish   status_berita_enum @default(DRAFT)
  berita_unggulan  Boolean            @default(false)
  berita_utama     Boolean            @default(false)
  views            Int                @default(0)
  share            Int                @default(0)
  tanggal_publish  DateTime?          @db.Timestamptz(6)
  tanggal_dibuat   DateTime           @default(now()) @db.Timestamptz(6)
  tanggal_diupdate DateTime           @default(now()) @db.Timestamptz(6)
