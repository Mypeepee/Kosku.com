// ── Tugas Agen ───────────────────────────────────────────────────────────────
model Tugas {
  id_tugas String @id @default(cuid())
  id_agent String @db.VarChar(20)

  judul     String               @db.VarChar(500)
  catatan   String?
  kategori  kategori_tugas_enum  @default(UMUM)
  prioritas prioritas_tugas_enum @default(SEDANG)
  status    status_tugas_enum    @default(BELUM)

  tanggal_mulai   DateTime? @db.Timestamptz(6)
  tanggal_selesai DateTime? @db.Timestamptz(6)
  selesai_pada    DateTime? @db.Timestamptz(6)
  jam_terjadwal   String?   @db.VarChar(10)

  target           Int?
  progress         Int     @default(0)
  alasan           String?
  komisi_potensial BigInt?

  id_lead      BigInt?
  id_listing   BigInt?
  id_transaksi String? @db.VarChar(50)
  /// Klien yang jadi sebab tugas ini ada. Diisi oleh asisten follow-up supaya
  /// tugas "Follow-up Budi" bisa membuka kartu Budi, bukan cuma menyebut
  /// namanya di judul.
  id_klien     String? @db.VarChar(20)

  /// KUNCI ANTI-DOBEL untuk tugas buatan mesin, mis.
  /// `SEPI:KL00007:2026-08-19` atau `PERUBAHAN:412`.
  /// Cron berjalan tiap 15 menit; tanpa kunci ini satu klien yang sepi
  /// menghasilkan 96 tugas identik sehari dan halaman Tugas berubah jadi
  /// tempat sampah — cara tercepat membuat agent berhenti mempercayai
  /// asistennya. Unik parsial: tugas manual (NULL) tidak tersentuh.
  kunci_otomatis String? @db.VarChar(160)

  is_overdue        Boolean @default(false)
  is_auto_generated Boolean @default(false)

  dibuat_pada     DateTime @default(now()) @db.Timestamptz(6)
  diperbarui_pada DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  agent         Agent      @relation(fields: [id_agent], references: [id_agent], onDelete: Cascade)
  lead          Lead?      @relation(fields: [id_lead], references: [id_lead], onDelete: SetNull)
  listing       Listing?   @relation(fields: [id_listing], references: [id_property], onDelete: SetNull)
  transaksi     Transaksi? @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: SetNull)
  Klien         Klien?     @relation(fields: [klienId_klien], references: [id_klien])
  klienId_klien String?    @db.VarChar(20)

  @@index([id_agent, status])
  @@index([id_agent, tanggal_selesai])
  @@map("tugas")
}

// ── Meta ringan per-tugas (termasuk tugas auto yang tak punya baris di `tugas`).
//    Disimpan per (agent, task_key) — key stabil seperti "cobroke-123", "listing-9".
model TugasMeta {
  id_agent   String   @db.VarChar(20)
  task_key   String   @db.VarChar(120)
  meta       Json     @default("{}")
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@id([id_agent, task_key])
  @@index([id_agent])
  @@map("tugas_meta")
}

enum kategori_tugas_enum {
  URGENT
  KONTEN
  FOLLOWUP
  VIEWING
  PIPELINE
  NETWORKING
  UMUM
}

